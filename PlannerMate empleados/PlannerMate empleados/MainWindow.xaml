<Window x:Class="PlannerMate_empleados.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PlannerMate_empleados"
        xmlns:tools="clr-namespace:MyApp.Tools"
        mc:Ignorable="d"
        Height="{Binding Source={x:Static SystemParameters.PrimaryScreenHeight}, Converter={tools:RatioConverter}, ConverterParameter='0.8' }"
        Width="{Binding Source={x:Static SystemParameters.PrimaryScreenHeight}, Converter={tools:RatioConverter}, ConverterParameter='1.5' }"
        WindowStartupLocation="CenterScreen"
        WindowStyle="None"
        AllowsTransparency="True" Background="Transparent">

    <!-- Tendremos el fondo transparente para modificar la vista de la ventana -->
    <!-- Añadimos la librería mindfusion (?)-->

    <Window.Resources>

        <Style x:Key="CircularButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="35"/>
            <Setter Property="Height" Value="35"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="Black"/>
            <Setter Property="BorderThickness" Value="1"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="20">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>

        </Style>

    </Window.Resources>

    <!-- El contenedor principal es un borde con un fondo, bordes redondeados -->
    <Border  BorderBrush="Black" CornerRadius="7" BorderThickness="1" Background="#FFD8D8D8">
        <DockPanel LastChildFill="False">
            <!-- Barra de Título Personalizada -->

            <Grid DockPanel.Dock="Top" Height="40"
                    MouseDown="DragWindow" MouseMove="MoveWindow" MouseUp="ReleaseWindow">

                <!-- Border para los corner redonditos (sujeto a posible cambio) -->
                <!--    Quitar, dejar el contenido dentro del grid y cambiar color de grid -->
                <Border Background="#007ACC" CornerRadius="7,7,0,0">


                    <!-- Contenido de la Barra de Título -->
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Left" Text="Planner mate! (Empleados)"
                                   VerticalAlignment="Center" HorizontalAlignment="Left" Margin="10,0,0,0" Foreground="White"/>

                        <!-- Botón de Cerrar -->
                        <Button DockPanel.Dock="Right" Content="X" HorizontalAlignment="Right" VerticalAlignment="Center" Width="25" Height="25"
                                Click="CloseButton_Click" Foreground="Black" Margin="0,0,10,0"/>

                        <!-- Botón de Minimizar -->
                        <Button DockPanel.Dock="Right" Content="_" HorizontalAlignment="Right" VerticalAlignment="Center" Width="25" Height="25"
                                Click="MinimizeButton_Click" Foreground="Black" Margin="0,0,5,0"/>

                        <!-- Los botones los quitaremos de la barra. -->

                    </DockPanel>
                </Border>
            </Grid>
            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal">
                <Button  Content="1" Style="{StaticResource ResourceKey=CircularButtonStyle}"/>
                <Button  Content="2" Style="{StaticResource ResourceKey=CircularButtonStyle}"/>
            </StackPanel>
            
        </DockPanel>
    </Border>

</Window>
