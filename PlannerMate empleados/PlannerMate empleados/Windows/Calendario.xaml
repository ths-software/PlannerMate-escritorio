<UserControl x:Class="PlannerMate_empleados.Windows.Calendario"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PlannerMate_empleados.Windows"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">

    <UserControl.Resources>

        <Style TargetType="Border" x:Key="resaltarDiaActual">
            <Style.Triggers>
                <DataTrigger Binding="{Binding DiaActual}" Value="True">
                    <Setter Property="Background" Value="#FF87E0F7"/>
                    <!-- Cambiar a tu color de resaltado preferido -->
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <Style TargetType="Border" x:Key="resaltarDiaSeleccionado">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="#FFFFA74D"/>
                    <Setter Property="BorderThickness" Value="3"/>
                    <!-- Cambiar a tu color de resaltado preferido -->
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="DayTemplate">
            <Border Height="100" Background="white" BorderBrush="Black" BorderThickness="1">
                
                <Border.InputBindings>
                    <MouseBinding Gesture="LeftClick" Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType={x:Type UserControl}}}" CommandParameter="{Binding}"/>
                </Border.InputBindings>

                <Border x:Name="DayCeld" Style="{StaticResource resaltarDiaSeleccionado}">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <Border x:Name="TitleDay" DockPanel.Dock="Top" Style="{StaticResource resaltarDiaActual}">
                                <StackPanel>
                                    <TextBlock Text="{Binding}" HorizontalAlignment="Center"></TextBlock>
                                </StackPanel>
                            </Border>
                            <TextBlock TextAlignment="Center" Text="{Binding InfoCitas}"></TextBlock>
                        </DockPanel>
                    </StackPanel>
                </Border>

            </Border>
            
        </DataTemplate>

        <Style TargetType="Border" x:Key="diasCelds">

            <Setter Property="BorderBrush" Value="Black"></Setter>
            <Setter Property="BorderThickness" Value="0,1,0,1"></Setter>
        </Style>

        <Style TargetType="TextBlock" x:Key="diasCeldsText">

            <Setter Property="TextAlignment" Value="Center"></Setter>
            <Setter Property="FontSize" Value="18"></Setter>
            <Setter Property="Foreground" Value="White"></Setter>
        </Style>



    </UserControl.Resources>

    <DockPanel LastChildFill="True">
        <Border DockPanel.Dock="top" >
            <!-- Month/Year header -->

            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Width="300" Margin="0,0,10,0" TextAlignment="Center" VerticalAlignment="Center" Text="{Binding DisplayedMonthYear}" FontSize="30" />
                
                <Button Command="{Binding Path=AtrasarMesCommand}" Content="&lt;" Height="25" Width="25"></Button>
                
                <Button Command="{Binding Path=AdelantarMesCommand}" Content=">" Height="25" Width="25"></Button>
            </StackPanel>
        </Border>

        <Border DockPanel.Dock="Top" Background="#FF41426D">
            <UniformGrid Rows="1" Columns="7">
                <Border Style="{StaticResource diasCelds}" BorderThickness="1,1,0,1">
                    <TextBlock Text="Lunes" Style="{StaticResource diasCeldsText}"/>
                </Border>
                <Border Style="{StaticResource diasCelds}">
                    <TextBlock Text="Martes" Style="{StaticResource diasCeldsText}"/>
                </Border>
                <Border Style="{StaticResource diasCelds}">
                    <TextBlock Text="Miércoles" Style="{StaticResource diasCeldsText}"/>
                </Border>
                <Border Style="{StaticResource diasCelds}">
                    <TextBlock Text="Jueves" Style="{StaticResource diasCeldsText}"/>
                </Border>
                <Border Style="{StaticResource diasCelds}">
                    <TextBlock Text="Viernes" Style="{StaticResource diasCeldsText}"/>
                </Border>
                <Border Style="{StaticResource diasCelds}">
                    <TextBlock Text="Sábado" Style="{StaticResource diasCeldsText}"/>
                </Border>
                <Border Style="{StaticResource diasCelds}" BorderThickness="0,1,1,1">
                    <TextBlock Text="Domingo" Style="{StaticResource diasCeldsText}"/>
                </Border>
            </UniformGrid>
        </Border>
        <Border >
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <!-- Add more column definitions if needed for day names, etc. -->
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <!-- Add more row definitions if needed for month/year header, etc. -->
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>



                <!-- Calendar grid -->
                <ItemsControl x:Name="CalendarItemsControl" ItemsSource="{Binding Days}" ItemTemplate="{StaticResource DayTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="6" Columns="7"/>
                            <!-- 6 rows, 7 columns for the days -->
                        </ItemsPanelTemplate>
                        
                    </ItemsControl.ItemsPanel>


                    
                </ItemsControl>
                
            </Grid>
        </Border>
    </DockPanel>

</UserControl>
