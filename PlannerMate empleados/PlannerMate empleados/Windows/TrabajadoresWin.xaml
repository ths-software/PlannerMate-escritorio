<UserControl x:Class="PlannerMate_empleados.Windows.TrabajadoresWin"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:local="clr-namespace:PlannerMate_empleados.Windows"
             mc:Ignorable="d" 
             d:DesignHeight="450" d:DesignWidth="800">
    <Grid>

        <ListBox ItemsSource="{Binding Trabajadores}" Background="#FFE8E8E8" BorderBrush="Transparent" Padding="10">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>

                            <Image Width="50" Height="50" Margin="0,0,10,0" Source="/Resources/hombre.png"/>

                            <StackPanel Grid.Column="1">
                                <TextBlock Text="{Binding nombre}" FontWeight="Bold"/>
                                <TextBlock Text="{Binding contacto}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

    </Grid>
</UserControl>
