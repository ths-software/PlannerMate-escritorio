<Window x:Class="PlannerMate_empleados.Windows.AddCitaWin"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:PlannerMate_empleados.Windows"
        mc:Ignorable="d"
        Title="AddCitaWin" Height="600" MinHeight="590" Width="700">

    <Window.Resources>
        <Style TargetType="StackPanel" x:Key="stack1">
            <Setter Property="Margin" Value="20,10,0,20"></Setter>
            <Setter Property="HorizontalAlignment" Value="Left"></Setter>
        </Style>

        <Style TargetType="Button">
            <Setter Property="Width" Value="60"></Setter>
            <Setter Property="Height" Value="30"></Setter>
            <Setter Property="Margin" Value="0,0,20,0"></Setter>
        </Style>

        <Style TargetType="TextBox">
            <Style.Resources>
                <Style TargetType="{x:Type Border}">
                    <Setter Property="CornerRadius" Value="5" />
                </Style>
            </Style.Resources>
            <Setter Property="BorderBrush" Value="#FFA4A4A4"></Setter>
            <Setter Property="Height" Value="30"></Setter>
            <Setter Property="Width" Value="500"></Setter>
            <Setter Property="VerticalAlignment" Value="Center"></Setter>
        </Style>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <StackPanel DockPanel.Dock="Top">
            <TextBlock Text="{Binding DiaSeleccionado.DayNumber}" FontSize="20" Margin="20,0,0,0"></TextBlock>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right"
                    Height="70">
            <Button Content="Cancelar"></Button>
            <Button Command="{Binding AddCitaCommand}" Content="Aceptar"></Button>
        </StackPanel>
        <StackPanel>
            <TextBlock Text="IdCita: 0" Margin="24,0,0,0"></TextBlock>

            <StackPanel Style="{StaticResource stack1}">
                <TextBlock Text="Nombre"></TextBlock>
                <TextBox Text="{Binding Path=CitaToAdd.Nombre}"></TextBox>
            </StackPanel>
            <StackPanel Style="{StaticResource stack1}">
                <TextBlock Text="Contacto"></TextBlock>
                <TextBox Text="{Binding Path=CitaToAdd.Contacto}"></TextBox>
            </StackPanel>
            <StackPanel Style="{StaticResource stack1}">
                <TextBlock Text="Hora (HH:mm:ss)"></TextBlock>
                <StackPanel Orientation="Horizontal">

                    <TextBox Margin="0,0,10,0" Text="{Binding Path=HoraToAdd}"></TextBox>
                </StackPanel>
            </StackPanel>
            <StackPanel Style="{StaticResource stack1}">
                <TextBlock Text="Descripcion"></TextBlock>
                <TextBox Text="{Binding CitaToAdd.Descripcion}"></TextBox>
            </StackPanel>
            <StackPanel Style="{StaticResource stack1}">
                <TextBlock Text="peluquero (quizás hacer un dropdown)"></TextBlock>
                <TextBox></TextBox>
            </StackPanel>
            <StackPanel Style="{StaticResource stack1}">
                <TextBlock Text="Cliente (opcional, pensar un método para que cuadre con los clientes)"></TextBlock>
                <TextBox></TextBox>
            </StackPanel>

        </StackPanel>
    </DockPanel>
</Window>
